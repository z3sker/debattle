# Local simulator development only. Never enable beta authentication publicly.
HOST=127.0.0.1
PORT=8788
DEBATTLE_MODE=beta
DATABASE_PATH=./data/hackathon.sqlite

# Optional. Supply your own key locally; never commit it.
GROQ_API_KEY=

# Optional Solana devnet-only publisher. Create a separate devnet keypair privately.
# Only the file path goes here. Never paste the key into source or commit its file.
# SOLANA_DEVNET_KEYPAIR_PATH=.local/solana-devnet-key.json
